{
	"name": "n8n-nodes-buffer",
	"version": "0.2.5",
	"description": "n8n community node for Buffer API",
	"license": "MIT",
	"homepage": "",
	"keywords": [
		"n8n-community-node-package"
	],
	"author": {
		"name": "Prama Aditya",
		"email": "prama13@gmail.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/PramaAditya/n8n-nodes-buffer.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"prepublishOnly": "npm run build"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": false,
		"credentials": [
			"dist/credentials/BufferApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Buffer/BufferUploader.node.js",
			"dist/nodes/YtDlpS3/YtDlpS3.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1045.0",
		"@aws-sdk/lib-storage": "^3.1045.0"
	}
}
